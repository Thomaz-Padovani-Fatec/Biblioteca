APP_NAME="Biblioteca API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
# Use a Session pooler (não a Direct connection) — a Direct connection só
# resolve por IPv6, e a maioria das redes domésticas não tem IPv6.
DB_HOST=aws-0-<região-do-seu-projeto>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<referência-do-seu-projeto>
DB_PASSWORD=

SESSION_DRIVER=database
SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173